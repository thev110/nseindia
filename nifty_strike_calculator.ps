//@version=5
indicator("NSE NIFTY Options Settle & ATM Strike Tool", overlay=true)

// --- User Inputs ---
strikeStep = input.int(50, title="Strike Step", options=[50, 100])
roundTo100 = input.bool(false, title="Force Round to 100s (e.g. 23700 / 23800)")

// --- Spot Price & Strike Calculation ---
spotPrice = request.security("NSE:NIFTY", "D", close)
if na(spotPrice)
    spotPrice := close

var float atmStrike = na
var float lowerStrike100 = na
var float upperStrike100 = na

if not na(spotPrice)
    if roundTo100
        atmStrike := math.round(spotPrice / 100) * 100
    else
        atmStrike := math.round(spotPrice / strikeStep) * strikeStep
        
    lowerStrike100 := math.floor(spotPrice / 100) * 100
    upperStrike100 := math.ceil(spotPrice / 100) * 100

// --- Option Symbols (TradingView Format) ---
// Note: If you subscribe to TV Option feeds, format is e.g. NSE:NIFTY2690823700CE
expiryString = input.string("26SEP", title="Expiry Code (e.g., 26SEP)")

callTickerATM = "NSE:NIFTY" + expiryString + str.tostring(atmStrike, "#") + "CE"
putTickerATM  = "NSE:NIFTY" + expiryString + str.tostring(atmStrike, "#") + "PE"

callSettlePrice = request.security(callTickerATM, "D", close, ignore_invalid_symbol=true)
putSettlePrice  = request.security(putTickerATM, "D", close, ignore_invalid_symbol=true)

float combinedSettle = na
if not na(callSettlePrice) and not na(putSettlePrice)
    combinedSettle := callSettlePrice + putSettlePrice

// --- Data Table on TradingView Chart ---
var table summaryTable = table.new(position.top_right, 4, 6, bgcolor=color.new(color.black, 20), border_width=1, border_color=color.gray)

if barstate.islast
    // Header
    table.cell(summaryTable, 0, 0, "Metric", bgcolor=color.navy, text_color=color.white)
    table.cell(summaryTable, 1, 0, "Value / Strike", bgcolor=color.navy, text_color=color.white)
    table.cell(summaryTable, 2, 0, "Call (CE)", bgcolor=color.navy, text_color=color.white)
    table.cell(summaryTable, 3, 0, "Put (PE)", bgcolor=color.navy, text_color=color.white)

    // Row 1: NIFTY Spot Price
    table.cell(summaryTable, 0, 1, "NIFTY Spot Close", text_color=color.white)
    table.cell(summaryTable, 1, 1, str.tostring(spotPrice, "#.##"), text_color=color.yellow)
    table.cell(summaryTable, 2, 1, "-", text_color=color.gray)
    table.cell(summaryTable, 3, 1, "-", text_color=color.gray)

    // Row 2: Computed ATM Strike
    table.cell(summaryTable, 0, 2, "ATM Strike", text_color=color.white)
    table.cell(summaryTable, 1, 2, str.tostring(atmStrike, "#"), text_color=color.cyan)
    table.cell(summaryTable, 2, 2, na(callSettlePrice) ? "N/A" : str.tostring(callSettlePrice, "#.##"), text_color=color.green)
    table.cell(summaryTable, 3, 2, na(putSettlePrice) ? "N/A" : str.tostring(putSettlePrice, "#.##"), text_color=color.red)

    // Row 3: Lower 100 Strike
    table.cell(summaryTable, 0, 3, "Lower Strike", text_color=color.white)
    table.cell(summaryTable, 1, 3, str.tostring(lowerStrike100, "#"), text_color=color.white)
    table.cell(summaryTable, 2, 3, "-", text_color=color.gray)
    table.cell(summaryTable, 3, 3, "-", text_color=color.gray)

    // Row 4: Upper 100 Strike
    table.cell(summaryTable, 0, 4, "Upper Strike", text_color=color.white)
    table.cell(summaryTable, 1, 4, str.tostring(upperStrike100, "#"), text_color=color.white)
    table.cell(summaryTable, 2, 4, "-", text_color=color.gray)
    table.cell(summaryTable, 3, 4, "-", text_color=color.gray)

    // Row 5: Combined Settle Price (Straddle)
    table.cell(summaryTable, 0, 5, "Combined (CE+PE)", text_color=color.white)
    table.cell(summaryTable, 1, 5, na(combinedSettle) ? "N/A" : str.tostring(combinedSettle, "#.##"), text_color=color.orange, bgcolor=color.new(color.orange, 80))
    table.cell(summaryTable, 2, 5, "-", text_color=color.gray)
    table.cell(summaryTable, 3, 5, "-", text_color=color.gray)
